// Actual visit and briefing routes, disposable PGlite databases and synthetic assets only.
import { createRequire } from 'node:module';
const require = createRequire(new URL('../backend/package.json', import.meta.url));
const express = require('express'), cors = require('cors'), request = require('supertest');
import { randomUUID, createHash } from 'node:crypto';
import { eq } from '../backend/node_modules/drizzle-orm/index.js';
import { spezialfragenPeriodFixture } from '../backend/tests/spezialfragen-period-fixture.ts';
import { createBriefingFixture, syntheticBriefingPdf } from '../backend/tests/gm-briefing-fixture.ts';
const v = await spezialfragenPeriodFixture(undefined, false, true);
const b = await createBriefingFixture();
b.setNow(new Date().toISOString());
const pdf = await syntheticBriefingPdf(2);
const upload = await b.service.upload(pdf, 'Synthetischer Wochenfokus.pdf', b.admin, randomUUID());
await b.service.save(upload.id, { expectedRevision: upload.draftRevision, title: 'Wochenfokus – Vorschau', description: 'Synthetisches Dokument für den Navigationstest.', visibleFrom: null, visibleUntil: null, pages: upload.pages });
const ready = (await b.service.list())[0]!;
await b.service.publish(ready.id, ready.draftRevision, randomUUID(), b.admin);
const module = (await request(v.app).post('/admin/modules/main').auth('synthetic-gm-admin', { type: 'bearer' }).send({ name: 'Platzierung', questions: [{ type: 'numeric', text: 'Wie viele Displays sind vorhanden?', required: false, config: { min: 0, max: 99 }, rules: [], scoring: {} }] }).expect(201)).body.module;
const form = (await request(v.app).post('/admin/fragebogen/main').auth('synthetic-gm-admin', { type: 'bearer' }).send({ name: 'Standardfragebogen Vorschau', status: 'active', moduleIds: [module.id] }).expect(201)).body.fragebogen;
const campaign = randomUUID();
await v.database.insert(v.schema.campaigns).values({ id: campaign, name: 'Standard – synthetische Kampagne', section: 'standard', status: 'active', scheduleType: 'always', currentFragebogenId: form.id });
await v.database.insert(v.schema.campaignMarketAssignments).values({ campaignId: campaign, marketId: v.ids.market, gmUserId: v.ids.gm });
const source = (await request(v.app).post('/gm/visit-sessions').auth('synthetic-gm', { type: 'bearer' }).send({ marketId: v.ids.market, campaignIds: [campaign], clientSessionToken: 'synthetic-historical' }).expect(201)).body;
await request(v.app).patch(`/gm/visit-sessions/${source.session.id}/answers`).auth('synthetic-gm', { type: 'bearer' }).send({ visitQuestionId: source.sections[0].questions[0].id, answer: 2 }).expect(200);
const historical = (await v.database.select().from(v.schema.visitAnswers))[0]!;
await v.database.insert(v.schema.visitAnswerPhotos).values({ visitAnswerId: historical.id, storageBucket: 'synthetic-history', storagePath: 'preserved/photo.jpg' });
await v.database.update(v.schema.visitSessions).set({ status: 'submitted', submittedAt: new Date() }).where(eq(v.schema.visitSessions.id, source.session.id));
const draft = (await request(v.app).post('/gm/visit-sessions').auth('synthetic-gm', { type: 'bearer' }).send({ marketId: v.ids.market, campaignIds: [campaign], clientSessionToken: 'synthetic-draft' }).expect(201)).body;
const app = express();
app.use(cors({ origin: ['http://127.0.0.1:3037', 'http://localhost:3037'] }));
app.use(express.json());
const user = { id: v.ids.gm, role: 'gm', email: 'gm@preview.invalid', firstName: 'Alex', lastName: 'Berger' };
const auth = () => ({ user, session: { accessToken: 'synthetic-gm', refreshToken: 'synthetic-refresh-gm', expiresAt: Math.floor(Date.now() / 1000) + 86400 } });
app.post('/auth/login', (_q, r) => r.json(auth()));
app.post('/auth/refresh', (_q, r) => r.json(auth()));
app.get('/auth/me', (_q, r) => r.json({ user }));
app.get('/employee-agreement/current', (_q, r) => r.json({ accepted: true, required: false }));
app.get('/gm/settings/text-scale', (_q, r) => r.json({ textScalePercent: 0 }));
app.patch('/gm/settings/text-scale', (_q, r) => r.json({ textScalePercent: 0 }));
const period = { id: randomUUID(), label: 'RED 11', periodIndex: 11, start: '2026-11-02', end: '2026-11-27', startDate: '2026-11-02', endDate: '2026-11-27', year: 2026, isCurrent: true, daysUntilEnd: 9, status: 'active' };
app.get('/red-month/current', (_q, r) => r.json({ current: period, config: { anchorStart: '2026-01-05', cycleWeeks: [4, 4, 5], timezone: 'Europe/Vienna' } }));
app.get('/red-month/calendar', (_q, r) => r.json({ periods: [period] }));
app.get('/gm/dashboard/critical', async (_q, r) => { const rows = await v.database.select().from(v.schema.visitSessions).where(eq(v.schema.visitSessions.status, 'draft')); const s = rows[0]; r.json({ serverTime: new Date().toISOString(), daySession: { session: null, gate: { dayStarted: true, startKmPending: false, endKmPending: false, pauseOpen: false } }, activeVisit: s ? { sessionId: s.id, startedAt: s.startedAt?.toISOString(), marketId: v.ids.market, marketName: 'Billa', marketAddress: 'Testgasse 1', marketPostalCode: '1010', marketCity: 'Wien', campaignIds: [campaign], campaignNames: ['Standard – synthetische Kampagne'] } : null, activeTimeTrackingDrafts: [], redPeriod: period }); });
app.get('/__synthetic/identity', (_q, r) => r.json({ synthetic: true, gmId: v.ids.gm, marketId: v.ids.market, campaignId: campaign, sessionId: draft.session.id, url: `/gm/marktbesuch?chain=Billa&address=Testgasse%201&marketId=${v.ids.market}&campaignIds=${campaign}&sessionId=${draft.session.id}` }));
app.get('/__synthetic/integrity', async (_q, r) => { const answers = await v.database.select().from(v.schema.visitAnswers); const photos = await v.database.select().from(v.schema.visitAnswerPhotos); const sessions = await v.database.select().from(v.schema.visitSessions); r.json({ answers, photos, sessions, digest: createHash('sha256').update(JSON.stringify({ answers, photos })).digest('hex') }); });
app.use('/markets', (q, r, next) => q.path.startsWith('/gm/visit-sessions') ? v.app(q, r, next) : next());
app.use(b.app);
app.get('/time-tracking/photo-tags', (_q, r) => r.json({ tags: [] }));
app.get('/markets/gm', (_q, r) => r.json({ markets: [] }));
for (const path of ['/markets/gm/assigned-active', '/markets/gm/flex-start-markets'])
    app.get(path, (_q, r) => r.json({ markets: [] }));
app.get('/markets/gm/stats', (_q, r) => r.json({ visited: 0, total: 0, visitedMarkets: 0, totalMarkets: 0 }));
app.get('/markets/gm/kpi-summary', (_q, r) => r.json({ ippAllTimeAvg: 94, ippSampleCount: 8, bonusCumulativeEur: 240, lastComputedAt: new Date().toISOString() }));
app.get('/markets/gm/bonus-summary', (_q, r) => r.json({ hasActiveWave: false, goals: [] }));
app.get('/markets/gm/kuehler-mhd-progress', (_q, r) => { const s = { current: 0, total: 0, percent: 0, markets: [] }; r.json({ kuehler: s, mhd: s, durcharbeit: s, generatedAt: new Date().toISOString(), timezone: 'Europe/Vienna', periodFallback: { startDate: period.start, endDate: period.end } }); });
app.get('/admin/kurti/layout', (_q, r) => r.json({ layout: null }));
app.get('/gm/action-briefings', (_q, r) => r.json({ items: [], unreadCount: 0 }));
app.get('/day-session/today-submissions', (_q, r) => r.json({ items: [], timeline: [], stats: null, session: null }));
app.get('/time-tracking/entries/draft/active', (_q, r) => r.json({ entries: [] }));
app.post('/telemetry/events', (_q, r) => r.sendStatus(204));
app.listen(4037, '127.0.0.1', () => console.log('Synthetic GM questionnaire + WSP API on4037; PGlite only.'));
